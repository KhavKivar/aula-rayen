<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.4.5">
  <diagram name="CD coordinada API + Web">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Entrega continua coordinada: API primero, web solo con la API verificada" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Un solo release: CI valida contratos + API + web, cada artefacto queda atado al commit, y la web espera a que /health reporte ese commit" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1220" height="20" as="geometry" />
        </mxCell>

        <mxCell id="push" value="Push a main&#xa;o Pull Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="ci.yml — PR y push&#xa;contracts + API + web&#xa;lint · typecheck · tests · build · check:landing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="280" height="80" as="geometry" />
        </mxCell>
