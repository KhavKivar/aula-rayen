        <mxCell id="build" value="build + push imagen GHCR&#xa;tag: sha-&amp;lt;commit&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
