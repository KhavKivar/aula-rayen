{
  "name": "@aula-rayen/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "prebuild": "pnpm --filter @aula-rayen/contracts build",
    "build": "vite build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:landing": "node scripts/check-landing-build.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "vite preview --port 3001",
    "prepare": "cd ../.. && husky .husky",
    "lint": "eslint",
    "pretest": "pnpm --filter @aula-rayen/contracts build",
    "test": "vitest",
    "pretest:run": "pnpm --filter @aula-rayen/contracts build",
    "test:run": "vitest run",
    "typecheck": "pnpm --filter @aula-rayen/contracts build && tsc --noEmit"
  },
  "dependencies": {
    "@aula-rayen/contracts": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "axios": "^1.19.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@10.33.0"
}
