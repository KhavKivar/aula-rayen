{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production site content",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "isDemo", "brand", "professional", "social", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "isDemo": { "const": false },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "professional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shortName", "title", "biography", "credentials"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "biography": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "credentials": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instagramUrl", "instagramHandle"],
      "properties": {
        "instagramUrl": { "type": "string", "format": "uri" },
        "instagramHandle": { "type": "string", "pattern": "^@" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileImageUrl", "profileImageAlt"],
      "properties": {
        "profileImageUrl": { "type": "string", "format": "uri" },
        "profileImageAlt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
