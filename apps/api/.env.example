# Use a development database or Neon branch locally.
# Production must inject its own value outside the repository.
DATABASE_URL=
# Public backend origin used by Transbank to return from the payment flow.
BASE_URL=http://localhost:3000
# Frontend origin used for payment result redirects and authentication.
FRONTEND_URL=http://localhost:3001
PORT=3000

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Production only: parent hostname shared by the frontend and API subdomains.
# BETTER_AUTH_COOKIE_DOMAIN=example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Use a sending-only API key and an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aula Rayen <no-reply@example.com>

# Integration uses Transbank's built-in test credentials.
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
