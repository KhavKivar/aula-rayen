# Local Compose/Dokploy uses the private service hostname `postgres`.
# Keep POSTGRES_PASSWORD URL-safe or percent-encode it in DATABASE_URL.
POSTGRES_USER=aula_rayen
POSTGRES_PASSWORD=
POSTGRES_DB=aula_rayen
DATABASE_URL=postgresql://aula_rayen:replace-me@postgres:5432/aula_rayen
# Optional container limits for a VPS with 4 GB RAM or more.
API_MEMORY_LIMIT=768m
API_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
# Public backend origin used by Transbank to return from the payment flow.
BASE_URL=http://localhost:3000
# Frontend origin used for payment result redirects and authentication.
FRONTEND_URL=http://localhost:3001
PORT=3000

BETTER_AUTH_SECRET=
# Debe resolver al mismo path interno de BASE_PATH. El Worker publica /api/auth, pero lo reescribe a /auth.
# En prod: BETTER_AUTH_URL=https://app.vasvani.shop/auth
BETTER_AUTH_URL=http://localhost:3000
BASE_PATH=/auth
# Production only: parent hostname shared by the frontend and API (ej. vasvani.shop). Con Worker same-origin sigue vigente.
# En prod: BETTER_AUTH_COOKIE_DOMAIN=vasvani.shop
# BETTER_AUTH_COOKIE_DOMAIN=example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir con BETTER_AUTH_URL + /callback/google.
# En prod: GOOGLE_REDIRECT_URI=https://app.vasvani.shop/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Use a sending-only API key and an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aula Rayen <no-reply@example.com>

# Integration uses Transbank's built-in test credentials.
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
