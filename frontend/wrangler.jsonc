{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aula-rayen",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
